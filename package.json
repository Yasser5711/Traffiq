{
  "name": "traffiq",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n sim,api,web -c gray,magenta,cyan \"bun run sim\" \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite",
    "sim": "bun scripts/simulate.ts",
    "reset": "bun -e \"require('fs').rmSync('data',{recursive:true,force:true})\"",
    "build": "vite build",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "mmdb-lib": "3.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/bun": "latest",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "country-flag-emoji-polyfill": "^0.1.10",
    "d3-geo": "3.1.1",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "world-atlas": "2.0.2"
  }
}
